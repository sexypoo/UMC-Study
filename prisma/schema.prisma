generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  password      String   @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @map("detail_address") @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(15)

  userFavorCategories UserFavorCategory[]
  reviews             Review[]
  userMissions        UserMission[]

  @@map("user")

}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model Restaurant {
  id        BigInt   @id @default(autoincrement())
  regionId  BigInt   @map("region_id")
  name      String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  score     Float    @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviews  Review[]
  missions Mission[]

  @@map("restaurant")
}

model Review {
  id           BigInt   @id @default(autoincrement())
  restaurantId BigInt   @map("restaurant_id")
  userId       Int      @map("user_id")
  rating       Float
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@map("review")
}

model Mission {
  id           BigInt   @id @default(autoincrement())
  restaurantId BigInt   @map("restaurant_id")
  point        Int
  mealPrice    Int      @map("meal_price")
  dueDate      DateTime @map("due_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  userMissions UserMission[]

  @@map("mission")
}

model UserMission {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  missionId BigInt   @map("mission_id")
  status    String   @default("CHALLENGING") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  mission Mission @relation(fields: [missionId], references: [id])

  @@map("user_mission")
}